{
  "name": "radar-fornecedores",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo GO CONDICIONAL (H5-G): radar de risco de fornecedores de energia para gestoras. Dados sintéticos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "dev:api": "tsx watch src/server/main.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/node/server/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "openapi": "tsx scripts/gen-openapi.ts",
    "economia": "python3 scripts/economia.py --atualizar",
    "backtest": "tsx scripts/backtest-fa.ts",
    "purge": "tsx scripts/purge.ts",
    "revoke-all": "tsx scripts/revoke-all.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^11.0.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
