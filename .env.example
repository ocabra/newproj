# Copie para .env. Nunca versione .env.
DATABASE_URL=postgres://radar:radar@localhost:55432/radar
# Banco usado pelos testes de integração (é recriado a cada execução)
TEST_DATABASE_URL=postgres://radar:radar@localhost:55432/radar_test
PORT=3000
API_HOST=127.0.0.1
NODE_ENV=development
# Origem pública do portal (checagem de Origin em requisições que alteram estado)
APP_ORIGIN=http://localhost:5173
# Senha de todos os usuários criados pelo seed (somente dados sintéticos; mínimo 10 caracteres)
SEED_PASSWORD=troque-esta-senha
